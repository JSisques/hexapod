# Build outputs
/build/

# Generated CAD / render artifacts (produced by make/CI, never committed)
*.stl
*.3mf
*.amf
*.off
*.gcode
*.png

# Curated documentation images are allowed
!/docs/**/*.png

# Python environments and caches (the committed params snapshot is JSON and not ignored)
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local tooling (skill registry cache)
/.atl/

# OS / editor noise
.DS_Store
*~
*.swp
.idea/
.vscode/
