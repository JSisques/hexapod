root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.scad]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[LICENSES/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
